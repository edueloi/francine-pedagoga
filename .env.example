# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Porta do servidor Express (local: 3000, produção/VPS: definir conforme necessário)
PORT=3000

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=francine_pedagoga

# JWT
JWT_SECRET=troque_por_uma_chave_secreta_forte

# E-mail transacional (SMTP)
# Atenção: o domínio real é "espaçoaprenderaser.com.br" (com cedilha) — em produção
# a caixa de e-mail e o domínio usam a forma Punycode: xn--espaoaprenderaser-dsb.com.br
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@xn--espaoaprenderaser-dsb.com.br
SMTP_PASSWORD=
EMAIL_FROM="Espaço Aprender a Ser <contato@xn--espaoaprenderaser-dsb.com.br>"
